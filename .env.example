APP_ENV=production
APP_DEBUG=false
APP_URL=https://kka.arsipdigital-inspektorat.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ganti_dengan_nama_db
DB_USER=ganti_dengan_user_db
DB_PASS=ganti_dengan_password_db

ADMIN_EMAIL=admin@inspektorat-rohil.go.id
ADMIN_PASSWORD=ganti_dengan_password_admin
SESSION_NAME=kka_sess
SESSION_LIFETIME=7200

# API Mobile
MOBILE_API_ALLOWED_ORIGINS=*
MOBILE_API_ACCESS_TTL=86400
