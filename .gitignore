# ============================================================
# JANGAN PERNAH COMMIT kredensial / file sensitif ke Git!
# ============================================================

# Kredensial database & konfigurasi produksi
.env
.env.*
!.env.example

# Koneksi langsung dengan kredensial hardcode
koneksi.php

# Log server & file diagnostik
error_log
*.log

# Archive source yang mengandung file produksi
src.zip
*.zip

# File backup/restore di repo
*.bak
*.tar.gz

# Node / Expo (mobile subproject punya .gitignore sendiri)
node_modules/
.expo/
dist/
web-build/
*.tsbuildinfo

# Sistem
.DS_Store
Thumbs.db
